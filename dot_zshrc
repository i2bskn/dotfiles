# Path
export PATH="$HOME/.local/bin:$PATH"

# Homebrew
eval "$(/opt/homebrew/bin/brew shellenv)"

# Zsh Core Configuration
HISTFILE=$HOME/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt share_history
setopt auto_cd

# Completions
if type brew &>/dev/null; then
  FPATH=$(brew --prefix)/share/zsh-completions:$FPATH
fi

autoload -Uz compinit
compinit -u

# Load Split Configurations
for file in $HOME/.zsh/*.zsh; do
  source "$file"
done

# Runtime Manager (mise)
export PATH="$HOME/.local/share/mise/shims:$PATH"
eval "$(mise activate zsh)"

# Prompt (Starship)
eval "$(starship init zsh)"

# direnv
eval "$(direnv hook zsh)"

if [ -d "/opt/homebrew/opt/postgresql@17/bin" ]; then
  export PATH="/opt/homebrew/opt/postgresql@17/bin:$PATH"
fi

if [ -d "/opt/homebrew/opt/mysql-client/bin" ]; then
  export PATH="/opt/homebrew/opt/mysql-client/bin:$PATH"
fi

# Reset kitty keyboard protocol on each prompt to prevent stuck CSI u mode
#autoload -Uz add-zsh-hook
#add-zsh-hook precmd _reset_keyboard_protocol
#_reset_keyboard_protocol() { printf '\e[<u\e[<u\e[<u\e[<u\e[<u'; }

# grok
export PATH="$HOME/.grok/bin:$PATH"
fpath=(~/.grok/completions/zsh $fpath)
autoload -Uz compinit && compinit -C

# opencode
export PATH=/Users/i2bskn/.opencode/bin:$PATH

